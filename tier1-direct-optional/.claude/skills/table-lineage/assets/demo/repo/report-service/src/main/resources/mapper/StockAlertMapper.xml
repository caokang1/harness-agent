<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.shop.report.mapper.StockAlertMapper">
    <insert id="insertAlerts">
        insert into stock_alert (rule_id, sku, store_id, qty) values
        <foreach collection="items" item="i" separator=",">(#{ruleId}, #{i.sku}, #{i.storeId}, #{i.qty})</foreach>
    </insert>
</mapper>
