# Harness Starter Kit · build-installer.sh 上传配置模板
#
# 用法：
#   cp scripts/.env.build.example scripts/.env.build
#   # 编辑 scripts/.env.build 填入真实值
#   bash scripts/build-installer.sh     # 会自动读取并上传
#
# scripts/.env.build 已加入 .gitignore，不会提交到仓库。

# MinIO API 地址（不含尾部斜杠）
MINIO_ENDPOINT=https://minio.example.com

# MinIO Access Key / Secret Key
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key

# 目标 Bucket 名称
MINIO_BUCKET=your-bucket

# Bucket 内的路径（默认 harness-starter/install.sh）
MINIO_PATH=harness-starter/install.sh

# mc alias 名称（随意，不冲突即可，默认 harness-minio）
# MINIO_ALIAS=harness-minio
