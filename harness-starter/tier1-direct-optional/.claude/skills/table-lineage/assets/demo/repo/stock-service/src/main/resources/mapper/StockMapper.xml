<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.shop.stock.mapper.StockMapper">
    <select id="selectLow" resultType="com.example.shop.common.dto.StockDTO">
        select id, sku, store_id, qty from stock where qty &lt; #{threshold}
    </select>
</mapper>
